<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MambaMQ.Studio.App"
             xmlns:local="using:MambaMQ.Studio"
             xmlns:converters="using:MambaMQ.Studio.Converters"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#10131A" />
        <SolidColorBrush x:Key="StudioPanelBackgroundBrush" Color="#151922" />
        <converters:BooleanToIconConverter x:Key="BooleanToIconConverter" />
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
    </Application.Resources>
    
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="FlyoutPresenter.settings-menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Application.Styles>

</Application>