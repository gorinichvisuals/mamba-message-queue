<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MambaMQ.Studio.ViewModels"
        x:Class="MambaMQ.Studio.Views.CreateExchangeWindow"
        x:DataType="vm:CreateExchangeViewModel"
        Title="Create Exchange"
        Icon="avares://MambaMQ.Studio/Assets/logo.ico"
        Width="480"
        Height="380"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource StudioBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource StudioPanelBackgroundBrush}"
                BorderBrush="#30FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Spacing="3">
                <TextBlock Text="Create Exchange"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="Configure exchange settings"
                           FontSize="12"
                           Opacity="0.55" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Exchange name" Opacity="0.65" />
                <TextBox Text="{Binding ExchangeName}"
                         Watermark="Enter exchange name"
                         Height="38" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Exchange type" Opacity="0.65" />
                <ComboBox ItemsSource="{Binding ExchangeTypes}"
                          SelectedItem="{Binding ExchangeType}"
                          Height="38" />
            </StackPanel>

            <CheckBox IsChecked="{Binding IsDurable}">
                <TextBlock Text="Durable" />
            </CheckBox>
            <TextBlock Text="Durable exchanges survive server restart."
                       FontSize="12"
                       Opacity="0.55"
                       Margin="24,-12,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource StudioPanelBackgroundBrush}"
                BorderBrush="#30FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        Click="CancelButton_OnClick"
                        Padding="18,9" />
                <Button Content="Create"
                        Click="CreateButton_OnClick"
                        IsDefault="True"
                        Padding="18,9" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
