<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MambaMQ.Studio.Views.ProfileEditorWindow"
        Title="Connection profile"
        Icon="avares://MambaMQ.Studio/Assets/logo.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource StudioBackgroundBrush}">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="HeadingText" Text="Connection profile" FontSize="22" FontWeight="SemiBold" />
        <TextBox x:Name="NameInput" PlaceholderText="Profile name (e.g. Production)" />
        <TextBox x:Name="HostInput" PlaceholderText="Host:Port" />
        <TextBox x:Name="UsernameInput" PlaceholderText="Username" />
        <TextBox x:Name="PasswordInput" PlaceholderText="Password" />
        <TextBlock x:Name="ValidationText" Foreground="#F87171" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Save" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>