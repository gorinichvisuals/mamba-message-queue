<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MambaMQ.Studio.ViewModels"
             xmlns:controls="using:MambaMQ.Studio.Controls"
             xmlns:views="clr-namespace:MambaMQ.Studio.Views"
             x:Class="MambaMQ.Studio.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>

        <Grid x:Name="DashboardContent">

            <Border Background="{DynamicResource StudioBackgroundBrush}" />

            <Grid RowDefinitions="56,*">

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="Exchanges"
                        Command="{Binding ShowExchangesCommand}"
                        Padding="24,11"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0" />
                <Button Content="Queues"
                        Command="{Binding ShowQueuesCommand}"
                        Padding="24,11"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="24,16">

                <ContentControl
                    Content="{Binding CurrentViewModel}" />

            </Border>

            </Grid>
        </Grid>

        <Border IsVisible="{Binding IsCompatibilityNoticeVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                MaxWidth="420"
                Margin="0,8,24,0"
                Padding="14,10"
                Background="#FF252B35"
                BorderBrush="#FFB547"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 4 18 0 #70000000">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <TextBlock Text="This server version is outdated. Some features may be unavailable."
                           Foreground="#FFD08A"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="×"
                        Command="{Binding DismissCompatibilityNoticeCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        FontSize="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#F4F7FB"
                        VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Border
            IsVisible="{Binding IsNavigationOverlayVisible}"
            Background="#990B1018"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">

                <controls:ConnectionSpinner
                    x:Name="ReconnectSpinner"
                    Width="80"
                    Height="80"
                    IsVisible="{Binding IsNavigationLoading}" />

                <TextBlock
                    Text="{Binding NavigationOverlayText}"
                    FontSize="15"
                    Foreground="#F4F7FB"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Back to sign in"
                    Command="{Binding DisconnectCommand}"
                    Padding="16,9"
                    HorizontalAlignment="Center" />

            </StackPanel>
        </Border>

    </Grid>

</UserControl>