<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MambaMQ.Studio.ViewModels"
             x:Class="MambaMQ.Studio.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>

        <Border Background="#10131A" />

        <Grid RowDefinitions="72,*">

            <Border
                Grid.Row="0"
                Background="#151922"
                BorderBrush="#30FFFFFF"
                BorderThickness="0,0,0,1">

                <Grid>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="24,0">

                        <Image
                            Source="avares://MambaMQ.Studio/Assets/logo.png"
                            Width="42"
                            Height="42"
                            Stretch="Uniform"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="MambaMQ Studio"
                            FontSize="20"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Button
                            Content="Exchanges"
                            Command="{Binding ShowExchangesCommand}"
                            Padding="20,10"
                            Background="Transparent"
                            BorderThickness="0" />

                        <Button
                            Content="Queues"
                            Command="{Binding ShowQueuesCommand}"
                            Padding="20,10"
                            Background="Transparent"
                            BorderThickness="0" />

                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="24,0">

                        <StackPanel
                            Spacing="1"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding Username}"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Text="{Binding ConnectionInfo}"
                                FontSize="12"
                                Opacity="0.55"
                                HorizontalAlignment="Right" />

                        </StackPanel>

                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">

                            <TextBlock
                                Text="☰"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <Button.Flyout>
                                <Flyout
                                    Placement="BottomEdgeAlignedRight"
                                    ShowMode="Transient">

                                    <Button
                                        Content="Disconnect"
                                        Command="{Binding DisconnectCommand}"
                                        Width="130"
                                        Padding="12,8"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#1B202B"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6" />

                                </Flyout>
                            </Button.Flyout>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <Border
                Grid.Row="1"
                Padding="32">

                <ContentControl
                    Content="{Binding CurrentViewModel}" />

            </Border>

        </Grid>

    </Grid>

</UserControl>