<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MambaMQ.Studio.ViewModels"
             xmlns:controls="using:MambaMQ.Studio.Controls"
             xmlns:views="clr-namespace:MambaMQ.Studio.Views"
             x:Class="MambaMQ.Studio.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>

        <Grid x:Name="DashboardContent">

            <Border Background="{DynamicResource StudioBackgroundBrush}" />

            <Grid RowDefinitions="56,*">

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="Exchanges"
                        Command="{Binding ShowExchangesCommand}"
                        Padding="24,11"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0" />
                <Button Content="Queues"
                        Command="{Binding ShowQueuesCommand}"
                        Padding="24,11"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="24,16">

                <ContentControl
                    Content="{Binding CurrentViewModel}" />

            </Border>

            </Grid>
        </Grid>

        <Border
            IsVisible="{Binding IsNavigationOverlayVisible}"
            Background="#990B1018"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">

                <controls:ConnectionSpinner
                    x:Name="ReconnectSpinner"
                    Width="80"
                    Height="80"
                    IsVisible="{Binding IsNavigationLoading}" />

                <TextBlock
                    Text="{Binding NavigationOverlayText}"
                    FontSize="15"
                    Foreground="#F4F7FB"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Back to sign in"
                    Command="{Binding DisconnectCommand}"
                    Padding="16,9"
                    HorizontalAlignment="Center" />

            </StackPanel>
        </Border>

    </Grid>

</UserControl>