<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MambaMQ.Studio.ViewModels"
             x:Class="MambaMQ.Studio.Views.QueuesView"
             x:DataType="vm:QueuesViewModel">

    <Grid RowDefinitions="Auto,*"
          Margin="24">

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

            <TextBlock
                Text="Queues"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="Create"
                    Click="CreateQueueButton_OnClick"
                    Padding="16,8" />

                <Button
                    Content="Refresh"
                    Command="{Binding LoadCommand}"
                    Padding="16,8" />

            </StackPanel>
        </Grid>

        <DataGrid
            x:Name="QueuesGrid"
            Grid.Row="1"
            ItemsSource="{Binding Queues}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            CanUserResizeColumns="True"
            RowHeight="42"
            ClipboardCopyMode="None"
            CurrentCellChanged="QueuesGrid_OnCurrentCellChanged"
            KeyDown="QueuesGrid_OnKeyDown"
            DoubleTapped="QueuesGrid_OnDoubleTapped">

            <DataGrid.Styles>

                <Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="4,0" />
                </Style>

                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Padding" Value="4,0" />
                </Style>

            </DataGrid.Styles>

            <DataGrid.Columns>
                
                <DataGridTextColumn
                    Header="Name"
                    Binding="{Binding Name}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Created At"
                    Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Available"
                    Binding="{Binding AvailableMessageCount}"
                    Width="*" />

                <DataGridTextColumn
                    Header="In Flight"
                    Binding="{Binding InFlightMessageCount}"
                    Width="*" />
                
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>