<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MambaMQ.Studio.ViewModels"
             x:Class="MambaMQ.Studio.Views.QueuesView"
             x:DataType="vm:QueuesViewModel">

    <Grid RowDefinitions="Auto,*"
          Margin="24">

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">

            <TextBlock
                Text="Queues"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="Create"
                    Click="CreateQueueButton_OnClick"
                    Padding="16,8" />

                <Button
                    Content="Refresh"
                    Command="{Binding LoadCommand}"
                    Padding="16,8" />

            </StackPanel>

        </Grid>

        <DataGrid
            x:Name="QueuesGrid"
            Grid.Row="1"
            ItemsSource="{Binding Queues}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            CanUserResizeColumns="True"
            RowHeight="42"
            ClipboardCopyMode="None"
            CurrentCellChanged="QueuesGrid_OnCurrentCellChanged">

            <DataGrid.Styles>

                <Style Selector="DataGridRow">
                    <Setter Property="BorderBrush"
                            Value="#30FFFFFF" />
                    <Setter Property="BorderThickness"
                            Value="0,0,0,1" />
                </Style>

                <Style Selector="DataGridColumnHeader /template/ Thumb#PART_ColumnHeaderGripper">
                    <Setter Property="Background"
                            Value="Transparent" />
                </Style>

            </DataGrid.Styles>

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Queue ID"
                    Binding="{Binding Id}"
                    Width="280" />

                <DataGridTextColumn
                    Header="Name"
                    Binding="{Binding Name}"
                    Width="180" />

                <DataGridTemplateColumn
                    Header="Durable"
                    Width="90">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <TextBlock
                                Text="{Binding IsDurable, Converter={StaticResource BooleanToIconConverter}}"
                                Foreground="{Binding IsDurable, Converter={StaticResource BooleanToColorConverter}}"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Header="Message Retention"
                    Width="150">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <TextBlock
                                Text="{Binding MessageRetentionEnabled, Converter={StaticResource BooleanToIconConverter}}"
                                Foreground="{Binding MessageRetentionEnabled, Converter={StaticResource BooleanToColorConverter}}"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Header="Retention Period"
                    Binding="{Binding MessageRetentionPeriod}"
                    Width="130" />

                <DataGridTextColumn
                    Header="Load Balancing"
                    Binding="{Binding LoadBalancingAlgorithm}"
                    Width="150" />
                
                <DataGridTextColumn
                    Header="Created At"
                    Binding="{Binding CreatedAt}"
                    Width="180" />

                <DataGridTextColumn
                    Header="Available"
                    Binding="{Binding AvailableMessageCount}"
                    Width="110" />

                <DataGridTextColumn
                    Header="In Flight"
                    Binding="{Binding InFlightMessageCount}"
                    Width="110" />

                <DataGridTextColumn
                    Header="Permissions"
                    Binding="{Binding PermissionsDisplay}"
                    Width="2*" />

                <DataGridTemplateColumn
                    Header="Actions"
                    Width="180">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:CompileBindings="False">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Button
                                    Content="Update"
                                    Click="UpdateQueueButton_OnClick"
                                    Padding="12,6" />

                                <Button
                                    Content="Delete"
                                    Command="{Binding DataContext.DeleteQueueCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="12,6" />

                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>