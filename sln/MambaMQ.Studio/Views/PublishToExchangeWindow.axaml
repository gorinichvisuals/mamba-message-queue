<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MambaMQ.Studio.ViewModels"
        x:Class="MambaMQ.Studio.Views.PublishToExchangeWindow"
        x:DataType="vm:PublishToExchangeViewModel"
        Title="Send Message to Exchange"
        Icon="avares://MambaMQ.Studio/Assets/logo.ico"
        Width="560" Height="440" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource StudioBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource StudioPanelBackgroundBrush}" BorderBrush="#30FFFFFF" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Spacing="3">
                <TextBlock Text="Send Message to Exchange" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="The exchange routes the message using this routing key." FontSize="12" Opacity="0.55" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="24" Spacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Routing key" Opacity="0.65" />
                <TextBox Text="{Binding RoutingKey}" Watermark="Enter routing key" Height="38" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Message" Opacity="0.65" />
                <TextBox Name="MessageTextBox" Text="{Binding Message}" Watermark="Enter message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource StudioPanelBackgroundBrush}" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="CancelButton_OnClick" Padding="18,9" />
                <Button Content="Send" Click="SendButton_OnClick" IsDefault="True" Padding="18,9" />
            </StackPanel>
        </Border>
    </Grid>
</Window>